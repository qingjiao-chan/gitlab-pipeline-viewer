<?xml version="1.0" encoding="UTF-8"?>
<!--
    plugin.xml = IntelliJ IDEA 插件清单（类似 application.yml + @SpringBootApplication）
    - 声明插件的 id / name / version / 依赖 / 各扩展点注册。
    - IDEA 加载插件时读取本文件。

    编码说明：本文件必须保持 UTF-8 编码（与 <?xml encoding="UTF-8"?> 声明一致）。
    build.gradle.kts 已配置 options.encoding="UTF-8" 与 ProcessResources
    filteringCharset="UTF-8"，打包时按 UTF-8 处理，因此可安全使用中文；
    不要以其他编码（如 Windows 默认的 GBK）保存本文件，否则会触发
    "invalid plugin descriptor" 校验错误。
-->
<idea-plugin>
    <id>com.gitlab.pipeline.viewer</id>
    <name>GitLab Pipeline Viewer</name>
    <vendor>qingjiao chan</vendor>
    <version>1.0.0</version>

    <description><![CDATA[
    <p>直接在 IntelliJ IDEA 中查看、触发和管理多个 GitLab 项目的 CI/CD 流水线，无需切换浏览器。</p>
    <ul>
        <li>自动识别当前窗口内所有项目的 Git 远程仓库，支持按 GitLab 项目组树选择目标项目</li>
        <li>浏览流水线列表与状态（成功 / 失败 / 运行中 / 等待中 / 已取消），并显示耗时与触发人</li>
        <li>一键触发流水线（支持自定义 CI/CD 变量），取消 / 重试流水线或单个 Job</li>
        <li>查看 Job 完整构建日志，支持关键字搜索、高亮与上一处 / 下一处跳转</li>
        <li>选中运行中的流水线时自动刷新构建日志</li>
    </ul>
    ]]></description>

    <!-- 依赖：类似 Spring Boot 的 starter，缺少时插件无法启动。
         Git 插件 id 是 "Git4Idea"（注意大小写），写错会导致依赖解析失败。 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <!-- 扩展点注册（类似注册路由 / 接口）。
         applicationService：把 GitLabSettings 注册为 IDEA 管理、可自动持久化的应用级
         单例（类似 @Service）。
         注意：applicationService 必须放在 <extensions defaultExtensionNs="com.intellij"> 内，
         直接放在 <idea-plugin> 下会报 "Unknown element: applicationService"。 -->
    <!-- 通知组（类似注册一个消息渠道），通过 NotificationGroupManager 按 id 创建通知。
         注意：在 2023.2 平台中 notificationGroup 是普通扩展点，必须放在
         <extensions defaultExtensionNs="com.intellij"> 内；<notifications> 包装元素
         只在 2024.1+ 才存在，这里使用会触发 "Unknown element: notifications" 校验错误。 -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="GitLab Pipeline Viewer" displayType="BALLOON"/>
        <applicationService
                serviceInterface="com.gitlab.pipeline.viewer.settings.GitLabSettings"
                serviceImplementation="com.gitlab.pipeline.viewer.settings.GitLabSettings"/>
        <toolWindow id="GitLab Pipelines" anchor="bottom"
                    factoryClass="com.gitlab.pipeline.viewer.extension.GitLabPipelineToolWindowFactory"
                    icon="/icons/gitlab-pipeline.svg"/>
    </extensions>
</idea-plugin>
